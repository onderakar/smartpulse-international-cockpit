generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Assets: GCPs and Components tracked for monitoring
model Asset {
  id              Int      @id @default(autoincrement())
  parentId        Int?
  name            String   @unique   // "GCP_{gcpId}" or "COMP_{componentId}"
  type            String              // GCP, BESS, SOLAR, WIND, HYDRO, THERMAL, LOAD, OTHER
  portalCompanyId Int?
  portalGroupId   Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parent   Asset?  @relation("AssetHierarchy", fields: [parentId], references: [id])
  children Asset[] @relation("AssetHierarchy")
  metrics  TimeSeriesData[]
}

// Data sources: SCADA_API, etc.
model DataSource {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  metrics TimeSeriesData[]
}

// Metric types: BAP, SOC, POWER_3054, etc.
model MetricType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  unit      String
  createdAt DateTime @default(now())

  metrics TimeSeriesData[]
}

// Time series data (TimescaleDB hypertable target)
model TimeSeriesData {
  effectiveTime DateTime
  recordedTime  DateTime @default(now())
  assetId       Int
  metricTypeId  Int
  dataSourceId  Int
  value         Float

  asset      Asset      @relation(fields: [assetId], references: [id])
  metricType MetricType @relation(fields: [metricTypeId], references: [id])
  dataSource DataSource @relation(fields: [dataSourceId], references: [id])

  @@id([effectiveTime, assetId, metricTypeId, dataSourceId, recordedTime])
  @@index([effectiveTime(sort: Desc)])
  @@index([assetId, metricTypeId])
}

// ── Configuration ──

model GroupProfile {
  id                         String   @id               // portal groupId e.g. "123"
  name                       String
  portalEnv                  String   @default("prod")  // "prod" | "staging" | "demo"
  assetMapping               Json     @default("{}")    // full AssetMapping as JSONB
  polling                    Json                       // PollingConfig as JSONB
  monitoringCredentials      Json?                      // { username, password }
  graphQlApiKey              String?
  scheduleBapEditable        Boolean  @default(false)
  defaultResolutionMinutes   Int?
  customAttributeDefinitions Json?                      // AttributeDefinition[]
  portfolioMap               Json?                      // Record<number, PortfolioData>
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  users UserProfile[]
}

model UserProfile {
  id           String       @id               // username
  groupId      String
  widgetLayout Json?                          // WidgetLayoutItem[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  group GroupProfile @relation(fields: [groupId], references: [id])

  @@index([groupId])
}

// ── Schedule Revisions ──

model ScheduleRevision {
  id            Int      @id @default(autoincrement())
  gcpId         Int
  dateKey       String                        // "2026-04-08"
  deliveryStart String                        // slot key
  row           Json                          // full ScheduleRow
  fetchedAt     BigInt                        // epoch ms
  contentHash   String
  source        String   @default("ftp")      // "ftp" | "user_save"
  createdAt     DateTime @default(now())

  @@unique([gcpId, dateKey, deliveryStart, contentHash])
  @@index([gcpId, dateKey])
}

// ── File Ingestion ──

model FileSource {
  id              Int           @id @default(autoincrement())
  key             String                            // "technical-parameters", "dam-gen"
  displayName     String                            // "Technical Parameters"
  filename        String                            // "Technical_Parameters.csv"
  direction       String        @default("incoming") // "incoming" | "outgoing"
  fileType        String?                           // "csv" | "json" | "xml" | null = auto-detect
  intervalMinutes Int           @default(10)
  enabled         Boolean       @default(true)
  parserKey       String?                           // domain-specific parser key
  groupId         String

  lastCheckedAt   DateTime?
  lastError       String?

  versions        FileVersion[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([groupId, key])
  @@index([groupId, enabled])
}

model FileVersion {
  id          Int        @id @default(autoincrement())
  sourceId    Int
  versionNo   Int
  rawContent  String
  contentHash String
  sizeBytes   Int
  isCurrent   Boolean    @default(false)
  fetchedAt   DateTime   @default(now())

  source      FileSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, contentHash])
  @@index([sourceId, isCurrent])
  @@index([sourceId, fetchedAt(sort: Desc)])
}

// ── Portfolio Mapping ──

model PortfolioMapping {
  id            Int      @id @default(autoincrement())
  groupId       String
  portfolioType String   @default("DAM")  // "DAM" | "IDM" | "AFRR"
  externalId    String                     // IBEX portfolio ID: "B00214-10"
  displayName   String?                    // optional user label
  companyId     Int                        // SmartPulse PortalCompany.id
  companyName   String                     // denormalized for display
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  updatedBy     String?                    // username

  @@unique([groupId, portfolioType, externalId])
  @@unique([groupId, portfolioType, companyId])
  @@index([groupId, portfolioType])
}
