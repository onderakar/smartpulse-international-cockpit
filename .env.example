# Server
PORT=3001
NODE_ENV=development
SESSION_SECRET=change-me-in-production
CLIENT_ORIGIN=http://localhost:5173

# Portal
PORTAL_BASE_URL=https://portal.smartpulse.io

# Monitoring
MONITORING_BASE_URL=https://api.connectivity.smartpulse.io

# PostgreSQL (for TimescaleDB time series)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartpulse_intl

# SCADA Worker
SCADA_POLL_INTERVAL_MS=15000

# Profile storage
PROFILE_STORAGE_DIR=./data/profiles
